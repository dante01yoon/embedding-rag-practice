# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env
# .env 는 비밀 파일입니다. 깃허브에 올리거나 남에게 보내지 마세요(.gitignore에 들어 있습니다).

# OpenRouter 키 (https://openrouter.ai/keys 에서 발급). 한 키로 여러 회사 모델을 쓸 수 있습니다.
OPENAI_API_KEY=sk-or-여기에_내_키를_붙여_넣으세요
OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL=anthropic/claude-haiku-5.5
# 이 강의 영상은 위 모델(Claude Haiku 5.5)로 찍었습니다. 더 아끼려면 아래 둘 중 하나로 바꿉니다(결과 숫자는 영상과 조금 다를 수 있음).
# MODEL=qwen/qwen3.7-flash
# MODEL=deepseek/deepseek-v4.1-flash

# OpenAI 키를 직접 쓴다면: OPENAI_BASE_URL 줄을 지우고 MODEL 에 OpenAI 모델 이름을 적습니다.
